<mxfile host="app.diagrams.net" modified="2026-11-09T01:30:00.000Z" agent="Antigravity" version="24.0.0" type="device">
  
  <!-- ========================================== -->
  <!-- PAGE 1: TỔNG QUAN KIẾN TRÚC MICROSERVICES -->
  <!-- ========================================== -->
  <diagram id="diagram_overview" name="1. Kiến Trúc Tổng Quan Hệ Thống">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" background="#f8fafc">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Header Title Banner -->
        <mxCell id="hdr_title" value="HỆ THỐNG PHÒNG KHÁM ĐA KHOA MEDISYNC - KIẾN TRÚC SPRING BOOT MICROSERVICES (MSS301 - NHÓM 09)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#0f766e;strokeColor=#115e59;fontColor=#ffffff;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1600" height="50" as="geometry" />
        </mxCell>

        <!-- ================= TIER 1: CLIENT TIER ================= -->
        <mxCell id="tier_client" value="TẦNG GIAO DIỆN NGƯỜI DÙNG (CLIENT LAYER - REACT + VITE)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0d9488;fontStyle=1;fontSize=13;fontColor=#0f766e;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="1600" height="120" as="geometry" />
        </mxCell>
        <mxCell id="client_patient" value="&lt;b&gt;Bệnh Nhân Portal&lt;/b&gt;&lt;br&gt;React + Vite (Port 5173)&lt;br&gt;&lt;i&gt;Đặt lịch khám, Quét QR trả phí, Xem lịch sử&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#14b8a6;fontColor=#0f172a;fontSize=12;shadow=1;" vertex="1" parent="tier_client">
          <mxGeometry x="60" y="40" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="client_doctor" value="&lt;b&gt;Bác Sĩ Portal&lt;/b&gt;&lt;br&gt;React + Vite (Port 5173)&lt;br&gt;&lt;i&gt;Duyệt ca khám, Xem bệnh án, Hoàn tất khám&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#0f172a;fontSize=12;shadow=1;" vertex="1" parent="tier_client">
          <mxGeometry x="440" y="40" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="client_admin" value="&lt;b&gt;Quản Trị Viên Portal (Admin)&lt;/b&gt;&lt;br&gt;React + Vite (Port 5173)&lt;br&gt;&lt;i&gt;Điều phối toàn viện, Báo cáo doanh thu&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;fontColor=#0f172a;fontSize=12;shadow=1;" vertex="1" parent="tier_client">
          <mxGeometry x="820" y="40" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="client_external" value="&lt;b&gt;Cổng Thanh Toán Ngoài (VNPay / MoMo)&lt;/b&gt;&lt;br&gt;Mô phỏng QR Code Banking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#92400e;fontSize=12;shadow=1;" vertex="1" parent="tier_client">
          <mxGeometry x="1200" y="40" width="340" height="60" as="geometry" />
        </mxCell>

        <!-- ================= TIER 2: API GATEWAY & DISCOVERY ================= -->
        <mxCell id="tier_gateway" value="TẦNG CỔNG KẾT NỐI &amp; ĐIỀU PHỐI (API GATEWAY &amp; SERVICE DISCOVERY)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontStyle=1;fontSize=13;fontColor=#1e40af;" vertex="1" parent="1">
          <mxGeometry x="50" y="270" width="1600" height="150" as="geometry" />
        </mxCell>
        <mxCell id="gw_api" value="&lt;b&gt;API GATEWAY (Spring Cloud Gateway - Port 8080)&lt;/b&gt;&lt;br&gt;• Single Entry Point (Cổng ngõ duy nhất đón mọi Request)&lt;br&gt;• JWT Authentication Filter &amp; Token Validator&lt;br&gt;• Dynamic Routing (lb://USER-SERVICE, lb://APPOINTMENT-SERVICE, ...)&lt;br&gt;• Rate Limiting &amp; Correlation ID Filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;shadow=1;align=left;spacingLeft=15;" vertex="1" parent="tier_gateway">
          <mxGeometry x="60" y="40" width="680" height="90" as="geometry" />
        </mxCell>
        <mxCell id="infra_eureka" value="&lt;b&gt;EUREKA SERVER (Port 8761)&lt;/b&gt;&lt;br&gt;Service Registry &amp; Discovery&lt;br&gt;&lt;i&gt;Tự động đăng ký &amp; theo dõi nhịp tim (Heartbeat) của 6 Microservices&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;fontColor=#065f46;fontSize=12;shadow=1;" vertex="1" parent="tier_gateway">
          <mxGeometry x="800" y="40" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="infra_config" value="&lt;b&gt;CONFIG SERVER (Port 8889)&lt;/b&gt;&lt;br&gt;Quản lý cấu hình tập trung&lt;br&gt;&lt;i&gt;Lưu trữ datasource, secret JWT, RabbitMQ cấu hình tại clinic-config-repo&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontColor=#78350f;fontSize=12;shadow=1;" vertex="1" parent="tier_gateway">
          <mxGeometry x="1200" y="40" width="340" height="90" as="geometry" />
        </mxCell>

        <!-- ================= TIER 3: BUSINESS MICROSERVICES ================= -->
        <mxCell id="tier_services" value="TẦNG CÁC DỊCH VỤ NGHIỆP VỤ (6 BUSINESS MICROSERVICES - SPRING BOOT 3)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9333ea;fontStyle=1;fontSize=13;fontColor=#6b21a8;" vertex="1" parent="1">
          <mxGeometry x="50" y="460" width="1600" height="230" as="geometry" />
        </mxCell>

        <!-- S1: User Service -->
        <mxCell id="svc_user" value="&lt;b&gt;1. user-service&lt;/b&gt;&lt;br&gt;&lt;font color='#059669'&gt;Port: 8085&lt;/font&gt;&lt;br&gt;• Clean Architecture / DDD&lt;br&gt;• Cấp phát JWT &amp; Refresh Token&lt;br&gt;• Mã hóa mật khẩu BCrypt&lt;br&gt;• Phân quyền Role RBAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#0f172a;fontSize=11;shadow=1;" vertex="1" parent="tier_services">
          <mxGeometry x="40" y="40" width="230" height="160" as="geometry" />
        </mxCell>

        <!-- S2: Appointment Service -->
        <mxCell id="svc_appointment" value="&lt;b&gt;2. appointment-service&lt;/b&gt;&lt;br&gt;&lt;font color='#059669'&gt;Port: 8081&lt;/font&gt;&lt;br&gt;• Nghiệp vụ cốt lõi: Đặt lịch&lt;br&gt;• State: PENDING ➔ CONFIRMED ➔ COMPLETED&lt;br&gt;• &lt;b&gt;OpenFeign Client&lt;/b&gt; gọi Doctor&lt;br&gt;• &lt;b&gt;SAGA Orchestrator&lt;/b&gt;&lt;br&gt;• RabbitMQ Event Producer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#0f172a;fontSize=11;shadow=1;" vertex="1" parent="tier_services">
          <mxGeometry x="300" y="40" width="250" height="160" as="geometry" />
        </mxCell>

        <!-- S3: Doctor Service -->
        <mxCell id="svc_doctor" value="&lt;b&gt;3. doctor-service&lt;/b&gt;&lt;br&gt;&lt;font color='#059669'&gt;Port: 8082&lt;/font&gt;&lt;br&gt;• Quản lý hồ sơ bác sĩ&lt;br&gt;• Phân chuyên khoa, phòng khám&lt;br&gt;• Quản lý ca trực &amp; slot khám&lt;br&gt;• Cung cấp API cho FeignClient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#0f172a;fontSize=11;shadow=1;" vertex="1" parent="tier_services">
          <mxGeometry x="580" y="40" width="230" height="160" as="geometry" />
        </mxCell>

        <!-- S4: Patient Service -->
        <mxCell id="svc_patient" value="&lt;b&gt;4. patient-service&lt;/b&gt;&lt;br&gt;&lt;font color='#059669'&gt;Port: 8084&lt;/font&gt;&lt;br&gt;• Hồ sơ y tế bệnh nhân&lt;br&gt;• Nhóm máu, tiền sử dị ứng thuốc&lt;br&gt;• Bệnh án điện tử (EMR)&lt;br&gt;• Bảo mật riêng tư chuẩn HIPAA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0891b2;fontColor=#0f172a;fontSize=11;shadow=1;" vertex="1" parent="tier_services">
          <mxGeometry x="840" y="40" width="230" height="160" as="geometry" />
        </mxCell>

        <!-- S5: Payment Service -->
        <mxCell id="svc_payment" value="&lt;b&gt;5. payment-service&lt;/b&gt;&lt;br&gt;&lt;font color='#059669'&gt;Port: 8086&lt;/font&gt;&lt;br&gt;• Quản lý hóa đơn viện phí&lt;br&gt;• Tích hợp cổng thanh toán QR&lt;br&gt;• Gọi OpenFeign cập nhật lịch&lt;br&gt;• &lt;b&gt;Compensating Transaction&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#0f172a;fontSize=11;shadow=1;" vertex="1" parent="tier_services">
          <mxGeometry x="1100" y="40" width="230" height="160" as="geometry" />
        </mxCell>

        <!-- S6: Notification Service -->
        <mxCell id="svc_notification" value="&lt;b&gt;6. notification-service&lt;/b&gt;&lt;br&gt;&lt;font color='#059669'&gt;Port: 8083&lt;/font&gt;&lt;br&gt;• RabbitMQ Event Consumer&lt;br&gt;• Gửi Email/SMS tự động&lt;br&gt;• Báo lịch khám, nhắc đóng tiền&lt;br&gt;• Tách biệt tải bất đồng bộ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;fontColor=#0f172a;fontSize=11;shadow=1;" vertex="1" parent="tier_services">
          <mxGeometry x="1360" y="40" width="200" height="160" as="geometry" />
        </mxCell>

        <!-- ================= TIER 4: MESSAGE BROKER (RABBITMQ) ================= -->
        <mxCell id="broker_rabbit" value="&lt;b&gt;RABBITMQ MESSAGE BROKER (AMQP Port 5672 | Web UI Port 15672)&lt;/b&gt;&lt;br&gt;Exchange: &lt;i&gt;clinic.exchange&lt;/i&gt; ➔ Routing Keys: &lt;i&gt;appointment.created, appointment.confirmed, payment.completed&lt;/i&gt; ➔ Queue: &lt;i&gt;notification.queue&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#c2410c;fontSize=12;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="720" width="1600" height="60" as="geometry" />
        </mxCell>

        <!-- ================= TIER 5: DATA PERSISTENCE (POSTGRESQL) ================= -->
        <mxCell id="tier_db" value="TẦNG CƠ SỞ DỮ LIỆU ĐỘC LẬP (DATABASE PER SERVICE - POSTGRESQL 16 DOCKER)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=13;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="50" y="810" width="1600" height="170" as="geometry" />
        </mxCell>

        <mxCell id="db_user" value="&lt;b&gt;user_db&lt;/b&gt;&lt;br&gt;Postgres (Port &lt;b&gt;55436&lt;/b&gt;)&lt;br&gt;Password: 123&lt;br&gt;Tables: users, roles, tokens&lt;br&gt;Flyway V1..V6" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#9333ea;fontSize=11;" vertex="1" parent="tier_db">
          <mxGeometry x="70" y="40" width="170" height="110" as="geometry" />
        </mxCell>

        <mxCell id="db_appointment" value="&lt;b&gt;appointment_db&lt;/b&gt;&lt;br&gt;Postgres (Port &lt;b&gt;55432&lt;/b&gt;)&lt;br&gt;Password: 123&lt;br&gt;Tables: appointments, history&lt;br&gt;Flyway V1..V6" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="tier_db">
          <mxGeometry x="340" y="40" width="170" height="110" as="geometry" />
        </mxCell>

        <mxCell id="db_doctor" value="&lt;b&gt;doctor_db&lt;/b&gt;&lt;br&gt;Postgres (Port &lt;b&gt;55433&lt;/b&gt;)&lt;br&gt;Password: 123&lt;br&gt;Tables: doctors, slots, leaves&lt;br&gt;Flyway V1..V8" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#2563eb;fontSize=11;" vertex="1" parent="tier_db">
          <mxGeometry x="610" y="40" width="170" height="110" as="geometry" />
        </mxCell>

        <mxCell id="db_patient" value="&lt;b&gt;patient_db&lt;/b&gt;&lt;br&gt;Postgres (Port &lt;b&gt;55435&lt;/b&gt;)&lt;br&gt;Password: 123&lt;br&gt;Tables: patients, records&lt;br&gt;Flyway V1..V7" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#0891b2;fontSize=11;" vertex="1" parent="tier_db">
          <mxGeometry x="870" y="40" width="170" height="110" as="geometry" />
        </mxCell>

        <mxCell id="db_payment" value="&lt;b&gt;payment_db&lt;/b&gt;&lt;br&gt;Postgres (Port &lt;b&gt;55437&lt;/b&gt;)&lt;br&gt;Password: 123&lt;br&gt;Tables: payments, invoices&lt;br&gt;Flyway V1..V2" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#ea580c;fontSize=11;" vertex="1" parent="tier_db">
          <mxGeometry x="1130" y="40" width="170" height="110" as="geometry" />
        </mxCell>

        <mxCell id="db_notification" value="&lt;b&gt;notification_db&lt;/b&gt;&lt;br&gt;Postgres (Port &lt;b&gt;55434&lt;/b&gt;)&lt;br&gt;Password: 123&lt;br&gt;Tables: notifications, logs&lt;br&gt;Flyway V1..V4" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#dc2626;fontSize=11;" vertex="1" parent="tier_db">
          <mxGeometry x="1375" y="40" width="170" height="110" as="geometry" />
        </mxCell>

        <!-- ================= CONNECTING EDGES ================= -->
        <!-- Client -> Gateway -->
        <mxCell id="edge_c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#0d9488;" edge="1" parent="1" source="tier_client" target="gw_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gateway -> Services -->
        <mxCell id="edge_gw_user" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9333ea;" edge="1" parent="1" source="gw_api" target="svc_user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_gw_appt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="1" source="gw_api" target="svc_appointment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_gw_doc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#2563eb;" edge="1" parent="1" source="gw_api" target="svc_doctor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_gw_pat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#0891b2;" edge="1" parent="1" source="gw_api" target="svc_patient">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_gw_pay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#ea580c;" edge="1" parent="1" source="gw_api" target="svc_payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- OpenFeign: Appointment -> Doctor -->
        <mxCell id="edge_feign_doc" value="OpenFeign (REST)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#059669;dashed=1;" edge="1" parent="1" source="svc_appointment" target="svc_doctor">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="520" />
              <mxPoint x="640" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- OpenFeign: Payment -> Appointment -->
        <mxCell id="edge_feign_pay" value="OpenFeign (markPaymentPaid)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#ea580c;dashed=1;" edge="1" parent="1" source="svc_payment" target="svc_appointment">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1180" y="500" />
              <mxPoint x="480" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- RabbitMQ: Appt -> Rabbit -> Notif -->
        <mxCell id="edge_rabbit_pub" value="Publish Event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#f97316;" edge="1" parent="1" source="svc_appointment" target="broker_rabbit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_rabbit_sub" value="@RabbitListener" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#dc2626;" edge="1" parent="1" source="broker_rabbit" target="svc_notification">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Service to DB connections -->
        <mxCell id="e_db1" style="strokeWidth=2;strokeColor=#9333ea;" edge="1" parent="1" source="svc_user" target="db_user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_db2" style="strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="1" source="svc_appointment" target="db_appointment"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_db3" style="strokeWidth=2;strokeColor=#2563eb;" edge="1" parent="1" source="svc_doctor" target="db_doctor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_db4" style="strokeWidth=2;strokeColor=#0891b2;" edge="1" parent="1" source="svc_patient" target="db_patient"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_db5" style="strokeWidth=2;strokeColor=#ea580c;" edge="1" parent="1" source="svc_payment" target="db_payment"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_db6" style="strokeWidth=2;strokeColor=#dc2626;" edge="1" parent="1" source="svc_notification" target="db_notification"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ========================================== -->
  <!-- PAGE 2: LUỒNG SAGA ĐẶT LỊCH & THANH TOÁN  -->
  <!-- ========================================== -->
  <diagram id="diagram_saga" name="2. Luồng SAGA Đặt Lịch &amp; Giao Dịch Bù Trừ">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="saga_hdr" value="LUỒNG GIAO DỊCH PHÂN TÁN SAGA (SAGA PATTERN) GIỮA APPOINTMENT VÀ PAYMENT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#1e3a8a;strokeColor=#172554;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1600" height="50" as="geometry" />
        </mxCell>

        <!-- Swimlane Steps -->
        <mxCell id="step1" value="&lt;b&gt;BƯỚC 1: BỆNH NHÂN ĐẶT LỊCH&lt;/b&gt;&lt;br&gt;Bệnh nhân chọn Bác sĩ, Ngày &amp; Khung giờ khám" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step2" value="&lt;b&gt;BƯỚC 2: KIỂM TRA SLOT KHÁM (OPENFEIGN)&lt;/b&gt;&lt;br&gt;Appointment gọi Doctor Service qua FeignClient để kiểm tra slot khả dụng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="130" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step3" value="&lt;b&gt;BƯỚC 3: KHỞI TẠO LỊCH HẸN (PENDING)&lt;/b&gt;&lt;br&gt;Lưu vào appointment_db trạng thái PENDING.&lt;br&gt;Tạo paymentStatus = AWAITING_PAYMENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="130" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step4" value="&lt;b&gt;BƯỚC 4: BẮN SỰ KIỆN SANG RABBITMQ&lt;/b&gt;&lt;br&gt;Bắn AppointmentCreatedEvent vào clinic.exchange để thông báo các service liên quan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="130" width="320" height="80" as="geometry" />
        </mxCell>

        <!-- SAGA Decision Branch -->
        <mxCell id="decision" value="BỆNH NHÂN THANH TOÁN VIỆN PHÍ QUA QR CODE?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="270" width="320" height="120" as="geometry" />
        </mxCell>

        <!-- Success Path -->
        <mxCell id="success_box" value="&lt;b&gt;TRƯỜNG HỢP 1: THANH TOÁN THÀNH CÔNG (COMMIT SAGA)&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Payment Service ghi nhận hóa đơn &lt;b&gt;PAID&lt;/b&gt;&lt;br&gt;2. Dùng OpenFeign gọi: &lt;code&gt;POST /api/appointments/{id}/payment-paid&lt;/code&gt;&lt;br&gt;3. Appointment đổi trạng thái sang &lt;b&gt;CONFIRMED&lt;/b&gt;&lt;br&gt;4. Bắn sự kiện &lt;i&gt;AppointmentConfirmedEvent&lt;/i&gt; sang RabbitMQ&lt;br&gt;5. Notification Service gửi Email/SMS xác nhận lịch khám thành công cho bệnh nhân" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#15803d;align=left;spacingLeft=15;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="450" width="560" height="180" as="geometry" />
        </mxCell>

        <!-- Failure / Compensating Action Path -->
        <mxCell id="fail_box" value="&lt;b&gt;TRƯỜNG HỢP 2: THANH TOÁN THẤT BẠI / TIMEOUT (COMPENSATING TRANSACTION)&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Hết hạn giữ chỗ hoặc bệnh nhân hủy thanh toán&lt;br&gt;2. Payment Service kích hoạt Giao dịch bù trừ gọi: &lt;code&gt;POST /api/appointments/{id}/payment-failed&lt;/code&gt;&lt;br&gt;3. Appointment Service tự động &lt;b&gt;ROLLBACK LỊCH VỀ CANCELED&lt;/b&gt;&lt;br&gt;4. Gọi FeignClient sang Doctor Service để &lt;b&gt;GIẢI PHÓNG SLOT KHÁM&lt;/b&gt; cho bệnh nhân khác&lt;br&gt;5. Bắn sự kiện &lt;i&gt;AppointmentCanceledEvent&lt;/i&gt; sang RabbitMQ để lưu log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;align=left;spacingLeft=15;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="450" width="560" height="180" as="geometry" />
        </mxCell>

        <!-- Connectors -->
        <mxCell id="s_e1" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="1" source="step1" target="step2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s_e2" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#2563eb;" edge="1" parent="1" source="step2" target="step3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s_e3" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#ca8a04;" edge="1" parent="1" source="step3" target="step4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s_e4" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#ea580c;" edge="1" parent="1" source="step4" target="decision">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="dec_yes" value="THÀNH CÔNG (PAID)" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#15803d;fontColor=#15803d;fontStyle=1;" edge="1" parent="1" source="decision" target="success_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dec_no" value="THẤT BẠI / TIMEOUT" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#b91c1c;fontColor=#b91c1c;fontStyle=1;" edge="1" parent="1" source="decision" target="fail_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ========================================== -->
  <!-- PAGE 3: LUỒNG XÁC THỰC JWT & PHÂN QUYỀN RBAC -->
  <!-- ========================================== -->
  <diagram id="diagram_auth" name="3. Luồng Xác Thực JWT &amp; Phân Quyền">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="auth_hdr" value="CƠ CHẾ BẢO MẬT XÁC THỰC JWT &amp; PHÂN QUYỀN VAI TRÒ (RBAC)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#581c87;strokeColor=#3b0764;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1600" height="50" as="geometry" />
        </mxCell>

        <mxCell id="box_login" value="&lt;b&gt;1. ĐĂNG NHẬP (POST /auth/login)&lt;/b&gt;&lt;br&gt;Client gửi Email + Mật khẩu lên User Service&lt;br&gt;User Service kiểm tra BCrypt Hash &amp; Role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="140" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="box_token" value="&lt;b&gt;2. CẤP PHÁT CẶP TOKEN&lt;/b&gt;&lt;br&gt;• Access Token: JWT ký HMAC256 (Hạn 1 giờ)&lt;br&gt;• Refresh Token: Lưu trong DB (Hạn 7 ngày)&lt;br&gt;Trả về cho Client lưu vào Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="140" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="box_request" value="&lt;b&gt;3. GỬI REQUEST KÈM BEARER TOKEN&lt;/b&gt;&lt;br&gt;Client gửi request kèm Header:&lt;br&gt;&lt;code&gt;Authorization: Bearer &amp;lt;JWT_TOKEN&amp;gt;&lt;/code&gt;&lt;br&gt;đến API Gateway (Port 8080)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="140" width="340" height="90" as="geometry" />
        </mxCell>

        <mxCell id="box_filter" value="&lt;b&gt;4. GATEWAY FILTER &amp; FORWARDING&lt;/b&gt;&lt;br&gt;API Gateway giải mã JWT, bóc tách userId, roles&lt;br&gt;Gắn vào Header nội bộ:&lt;br&gt;&lt;code&gt;X-User-Id, X-User-Role&lt;/code&gt;&lt;br&gt;chuyển tiếp tới các Service nội bộ an toàn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="140" width="340" height="90" as="geometry" />
        </mxCell>

        <!-- RBAC Permissions Grid -->
        <mxCell id="rbac_table" value="&lt;b&gt;BẢNG MA TRẬN PHÂN QUYỀN (RBAC - ROLE-BASED ACCESS CONTROL)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;BỆNH NHÂN (PATIENT - Nguyễn Mạnh Quân):&lt;/b&gt; Đặt lịch khám mới, Thanh toán viện phí, Xem hồ sơ cá nhân. Ẩn nút duyệt lịch, không xem bệnh án người khác.&lt;br&gt;• &lt;b&gt;BÁC SĨ (DOCTOR - BS. CKI Nguyễn Văn An):&lt;/b&gt; Quản lý ca trực, Duyệt lịch khám (Confirm), Hoàn tất khám (Complete), Xem bệnh án điện tử bệnh nhân điều trị.&lt;br&gt;• &lt;b&gt;QUẢN TRỊ VIÊN (ADMIN):&lt;/b&gt; Toàn quyền điều phối tất cả bác sĩ, quản trị tài khoản, kiểm soát doanh thu viện phí và giám sát cụm Microservices." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;align=left;spacingLeft=20;fontSize=13;lineHeight=1.6;" vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="1500" height="160" as="geometry" />
        </mxCell>

        <mxCell id="ae1" style="strokeWidth=2;strokeColor=#8b5cf6;" edge="1" parent="1" source="box_login" target="box_token"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae2" style="strokeWidth=2;strokeColor=#3b82f6;" edge="1" parent="1" source="box_token" target="box_request"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae3" style="strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="1" source="box_request" target="box_filter"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
